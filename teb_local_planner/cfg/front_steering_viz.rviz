Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 17
        Y: -7
        Z: 0
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: false
      Name: Straight
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /front_steering/straight
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: false
      Name: FeasibleArc
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /front_steering/feasible_arc
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: false
      Name: TightArc
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /front_steering/tight_arc
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: false
      Name: OptimizedArc
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /front_steering/optimized_arc
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Simulated1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /front_steering/full_simulated_1
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Simulated2
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /front_steering/full_simulated_2
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Simulated3
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /front_steering/full_simulated_3
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Simulated4
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /front_steering/full_simulated_4
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Simulated5
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /front_steering/full_simulated_5
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Playback
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /front_steering/playback
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: PlanSegments
      Namespaces:
        full_error: true
        full_label: true
        playback_label: true
        playback_pose: true
        playback_trail: true
        full_pose_1: true
        full_pose_2: true
        full_pose_3: true
        full_pose_4: true
        full_pose_5: true
        full_reference: true
        full_simulated: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /front_steering/plan_segments
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: FrontSteering
      Namespaces:
        feasible_arc: true
        optimized_arc: true
        optimized_velocity: true
        straight: true
        summary: true
        tight_arc: true
        time_stretched_velocity: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /front_steering/markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 42
      Focal Point:
        X: 16.7
        Y: -7.4
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.2
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
